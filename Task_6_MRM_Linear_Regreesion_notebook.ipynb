import base64
import io
import json
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# 1. Load Dataset & Calculate Data Outputs
df = pd.read_csv("CarPrice_Assignment.csv")
shape_text = f"Shape: {df.shape}\n"
missing_text = f"Missing values: {df.isnull().sum().sum()}\n"

# 2. Features & Encoding
numeric_features = [
    col for col in df.select_dtypes(include=np.number).columns
    if col not in ["price", "car_ID"]
]
categorical_features = [
    col for col in df.select_dtypes(include="object").columns
    if col != "CarName"
]
X_df = pd.get_dummies(
    df[numeric_features + categorical_features], drop_first=True, dtype=float
)
X = X_df.to_numpy()
y = df["price"].to_numpy()
num_feat_text = f"Number of features: {X.shape[1]}\n"

# 3. Train-Test Split
rng = np.random.default_rng(42)
indices = rng.permutation(len(X))
split = int(0.8 * len(X))
X_train, X_test = X[indices[:split]], X[indices[split:]]
y_train, y_test = y[indices[:split]], y[indices[split:]]
split_text = (
    f"Training samples: {len(X_train)}\nTesting samples: {len(X_test)}\n"
)

# 4. Feature Scaling (ddof=0)
mean = X_train.mean(axis=0)
std = X_train.std(axis=0, ddof=0)
keep = std > 0
X_train = (X_train[:, keep] - mean[keep]) / std[keep]
X_test = (X_test[:, keep] - mean[keep]) / std[keep]
X_train = np.c_[np.ones(len(X_train)), X_train]
X_test = np.c_[np.ones(len(X_test)), X_test]
scale_text = f"Processed features count: {X_train.shape[1] - 1}\n"

# 5. Model Training via Analytical Least Squares
theta, residuals, rank, s = np.linalg.lstsq(X_train, y_train, rcond=None)
train_text = "Model trained successfully via analytical least squares.\n"

# 6. Predictions & Metrics
test_predictions = X_test @ theta
mse = np.mean((test_predictions - y_test) ** 2)
rmse = np.sqrt(mse)
r2 = 1 - np.sum((y_test - test_predictions) ** 2) / np.sum(
    (y_test - y_test.mean()) ** 2
)
metrics_text = (
    "=== Performance Metrics ===\n"
    f"MSE : {mse:.4f}\n"
    f"RMSE: {rmse:.4f}\n"
    f"R²  : {r2:.4f}\n"
)


# Helper to convert matplotlib plots to Base64 embedded strings
def get_plot_b64():
  buf = io.BytesIO()
  plt.savefig(buf, format="png", bbox_inches="tight")
  buf.seek(0)
  b64_str = base64.b64encode(buf.read()).decode("utf-8")
  plt.close()
  return b64_str


# Plot 1: Actual vs Predicted
plt.figure(figsize=(8, 5))
plt.scatter(
    y_test, test_predictions, color="royalblue", alpha=0.7, edgecolors="k"
)
plt.plot(
    [y_test.min(), y_test.max()],
    [y_test.min(), y_test.max()],
    "r--",
    lw=2,
    label="Ideal Fit",
)
plt.xlabel("Actual Price")
plt.ylabel("Predicted Price")
plt.title("Actual vs Predicted Car Prices")
plt.legend()
plt.grid(True, linestyle="--", alpha=0.5)
plot1_b64 = get_plot_b64()

# Plot 2: Residual Plot
residuals_arr = y_test - test_predictions
plt.figure(figsize=(8, 5))
plt.scatter(
    test_predictions, residuals_arr, color="purple", alpha=0.7, edgecolors="k"
)
plt.axhline(y=0, color="red", linestyle="--", linewidth=2)
plt.xlabel("Predicted Prices")
plt.ylabel("Residuals (Actual - Predicted)")
plt.title("Residual Plot - Homoscedasticity Check")
plt.grid(True, linestyle="--", alpha=0.5)
plot2_b64 = get_plot_b64()

# Plot 3: Error Distribution Histogram
plt.figure(figsize=(8, 5))
plt.hist(residuals_arr, bins=20, color="teal", edgecolor="black", alpha=0.7)
plt.xlabel("Prediction Error (Residuals)")
plt.ylabel("Frequency")
plt.title("Distribution of Test Residuals")
plt.grid(True, linestyle="--", alpha=0.5)
plot3_b64 = get_plot_b64()

